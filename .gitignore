# Only the deployed site is tracked here (index.html, nexus_data.js,
# sync/audio/*.m4a, .nojekyll). Everything else (PDF, extraction scripts,
# IPA data sources, aeneas setup) is source/dev material needed to rebuild
# it, kept on disk but not committed.
*

!/.gitignore
!/index.html
!/nexus_data.js
!/.nojekyll
!/sync
!/sync/audio
!/sync/audio/*.m4a
